# Copy this file to .env in the project root (or in backend/) and edit if needed.
# Never put real API keys here. Never commit a filled .env file.

# FastAPI will only allow this origin in development CORS.
FRONTEND_ORIGIN=http://localhost:5173

# SQLite file created under backend/data/ when you start the API from backend/
DATABASE_URL=sqlite:///./data/learnloop.db

# Optional LLM (Milestone 8). Leave blank so the app works without a paid API.
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
